{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://interviewos-api-840661016057.asia-south1.run.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
