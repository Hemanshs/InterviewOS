# FastAPI application name
APP_NAME=interviewos-api
# Backend version string
APP_VERSION=1.0.0
# Enable debug mode for local development
DEBUG=False
# Use mock AI/service responses during development
USE_MOCK_AI=True
# Keep LLM calls mocked during development
USE_MOCK_LLM=true
# Keep STT calls mocked during development
USE_MOCK_STT=true
# Keep TTS calls mocked during development
USE_MOCK_TTS=true
# Soft budget guard for future AI usage tracking
DAILY_AI_BUDGET_USD=5.00
# Free plan total interview limit
FREE_INTERVIEW_TOTAL_LIMIT=1
# Free plan maximum questions per interview
FREE_SESSION_QUESTION_LIMIT=5
# Free plan maximum answer duration in seconds
FREE_MAX_AUDIO_SECONDS=60
# Enable voice generation caching
TTS_CACHE_ENABLED=true
# Raw audio retention policy after transcription
RAW_AUDIO_RETENTION=delete_immediately
# PostgreSQL connection string for asyncpg
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviewos
# Direct PostgreSQL connection string for Alembic migrations when using PgBouncer/poolers
ALEMBIC_DATABASE_URL=
# Supabase JWT secret used to verify access tokens
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
# Supabase public project URL
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Supabase anon key for frontend-authenticated API access
SUPABASE_ANON_KEY=your_anon_key_here
# Auth provider configuration
AUTH_PROVIDER=supabase
# Require JWT auth for protected endpoints
REQUIRE_AUTH=true
# Local development bypass only; never enable in production
DEV_AUTH_BYPASS=false
# Gemini Developer API key used for STT and LLM calls
GEMINI_API_KEY=
# Provider switches
STT_PROVIDER=gemini
LLM_PROVIDER=gemini
# Lowest-cost Gemini model for STT, question generation, answer evaluation, and reports
GEMINI_MODEL=gemini-2.5-flash-lite
# Keep reports on the same lowest-cost model by default
GEMINI_REPORT_MODEL=gemini-2.5-flash-lite
# ElevenLabs API key for future TTS integrations
ELEVENLABS_API_KEY=
# Voice ID for the AI interviewer — default is Rachel voice
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Allowed frontend origins for CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
