# FastAPI application name
APP_NAME=interviewos-api
# Backend version string
APP_VERSION=1.0.0
# Enable debug mode for local development
DEBUG=False
# Use mock AI/service responses during development
USE_MOCK_AI=True
# Soft budget guard for future AI usage tracking
DAILY_AI_BUDGET_USD=5.00
# Free plan total interview limit
FREE_INTERVIEW_TOTAL_LIMIT=1
# Free plan maximum questions per interview
FREE_SESSION_QUESTION_LIMIT=5
# Free plan maximum answer duration in seconds
FREE_MAX_AUDIO_SECONDS=60
# Enable voice generation caching
TTS_CACHE_ENABLED=true
# Raw audio retention policy after transcription
RAW_AUDIO_RETENTION=delete_immediately
# PostgreSQL connection string for asyncpg
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviewos
# Direct PostgreSQL connection string for Alembic migrations when using PgBouncer/poolers
ALEMBIC_DATABASE_URL=
# Supabase JWT secret used to verify access tokens
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
# OpenAI API key for future LLM integrations
OPENAI_API_KEY=
# ElevenLabs API key for future TTS integrations
ELEVENLABS_API_KEY=
# Whisper/STT API key for future transcription integrations
WHISPER_API_KEY=
# Allowed frontend origins for CORS
ALLOWED_ORIGINS=["http://localhost:3000"]
