# ============================================================
# InterviewOS Backend - Environment Variables
# Copy to .env and fill in your values
# ============================================================

# App
APP_NAME=interviewos-api
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/interviewos
ALEMBIC_DATABASE_URL=

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Auth behavior
AUTH_PROVIDER=supabase
REQUIRE_AUTH=true
DEV_AUTH_BYPASS=false

# AI / LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REPORT_MODEL=
USE_MOCK_LLM=false

# Speech-to-Text
STT_PROVIDER=gemini
USE_MOCK_STT=false

# Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
VOICE_ENABLED_DEFAULT=true
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
USE_MOCK_TTS=true
TTS_CACHE_ENABLED=true

# Cost control
DAILY_AI_BUDGET_USD=20
FREE_INTERVIEW_TOTAL_LIMIT=1
FREE_SESSION_QUESTION_LIMIT=5
FREE_MAX_AUDIO_SECONDS=60
FREE_MAX_AUDIO_MB=10
FREE_MAX_RESUME_MB=10
RAW_AUDIO_RETENTION=false

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BACKEND_CORS_ORIGINS=
VERCEL_URL=
